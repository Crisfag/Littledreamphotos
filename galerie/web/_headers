# Cloudflare Pages : en-têtes par chemin.
/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Polices : fichiers figés, gardés un an (« ! » retire l'en-tête de /assets/*,
# sinon Cloudflare Pages accolerait les deux valeurs).
/assets/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Icônes et manifeste : stables, mis en cache une semaine.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-*
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=604800

# Pages privées (galerie client, espace famille, contrat, facture, bon cadeau) : jamais indexées, même
# si un lien circule. La balise meta dit déjà la même chose ; l'en-tête
# couvre aussi les fichiers et les redirections.
/galerie
  X-Robots-Tag: noindex, nofollow, noarchive, noimageindex
/galerie.html
  X-Robots-Tag: noindex, nofollow, noarchive, noimageindex
/ecole
  X-Robots-Tag: noindex, nofollow, noarchive, noimageindex
/ecole.html
  X-Robots-Tag: noindex, nofollow, noarchive, noimageindex
/contrat
  X-Robots-Tag: noindex, nofollow, noarchive
/contrat.html
  X-Robots-Tag: noindex, nofollow, noarchive
/facture
  X-Robots-Tag: noindex, nofollow, noarchive
/facture.html
  X-Robots-Tag: noindex, nofollow, noarchive
/bon-cadeau
  X-Robots-Tag: noindex, nofollow, noarchive, noimageindex
/bon-cadeau.html
  X-Robots-Tag: noindex, nofollow, noarchive, noimageindex
