# Cloudflare Pages : en-têtes par chemin.
/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Icônes et manifeste : stables, mis en cache une semaine.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-*
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=604800

# Pages privées (galerie client, espace famille) : jamais indexées, même
# si un lien circule. La balise meta dit déjà la même chose ; l'en-tête
# couvre aussi les fichiers et les redirections.
/galerie
  X-Robots-Tag: noindex, nofollow, noarchive, noimageindex
/galerie.html
  X-Robots-Tag: noindex, nofollow, noarchive, noimageindex
/ecole
  X-Robots-Tag: noindex, nofollow, noarchive, noimageindex
/ecole.html
  X-Robots-Tag: noindex, nofollow, noarchive, noimageindex
